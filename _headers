# Cloudflare Pages headers for the ELIZA-2027 static publish tree.
#
# This file is staged at the publish root by scripts/pages-export.sh.
# index.html is the only page, so there is no SPA rewrite and no
#/_redirects. Correct content types are the point: the app is ES modules
# plus an optional WebAssembly encoder, and fonts must carry font types or
# some browsers refuse them. Cache policy is secondary: immutable vendor
# bytes cache long, everything else revalidates.

/*
  X-Content-Type-Options: nosniff

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*.mjs
  Content-Type: application/javascript; charset=utf-8

/*.js
  Content-Type: application/javascript; charset=utf-8

/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=0, must-revalidate

/*.ttf
  Content-Type: font/ttf
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/*.pack
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/*.cbn
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache
