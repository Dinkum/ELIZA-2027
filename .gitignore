# macOS
.DS_Store

# Editors
.vscode/
.idea/
*.swp
*~
*.bak
*.orig

# Node
node_modules/
npm-debug.log*

# Generated by `npm run vendor` from node_modules — rebuild after `npm ci`.
# Kept out of the tree so no third-party build output is committed; the
# provenance record (manifest.json) and the builder stay in.
/modes/extended/vendor/transformers.web.js

# Same rule for the offline runtime and weights: generated, large, and
# reproducible, with their revisions and hashes recorded in vendor/manifest.json.
# Vendored so the page runs with the network unplugged; not committed so the
# repo stays a repo rather than a binary drop.
/modes/extended/vendor/ort/
/modes/extended/vendor/model/
/modes/extended/vendor/families.vectors.json

# Python (font/ builds its tooling with uv)
__pycache__/
*.py[cod]
.venv/
venv/

# Scratch
*.local
/tmp/

# The architecture wiki is a working document, kept on the host rather than
# committed: it describes current state and is rewritten as the repo moves.
/wiki/

# Reference source artifacts are read-only: recovered MAD, the CACM paper, the
# CTSS reconstruction and its s709 tarballs. Provenance notes in references/
# are maintained locally. The directory stays on the host, so nothing under it
# is committed — including the nested ignores there, which are redundant.
/references/

# Leftovers from driving s709 by hand during differential debugging: its print
# log, its console's stderr, and the shell loop used to feed it start commands.
/445
/stfifo
/feeder.sh
/printlog.lst

# CTSS containers. They are built by the reconstruction's tools running under
# s709, not shipped: an empty 1302 is a quarter of a gigabyte, and the tapes
# beside it are derived. `dasd/` and `output/` are where `env.sh` puts them.
# The packed image and the card deck are the exception: they are the only
# artifacts the page fetches, so they are committed under modes/emulate/.
*.BIN
*.tap
/dasd/
/output/
!/modes/emulate/ctss-dasd.pack
!/modes/emulate/cmd.cbn

# Logs are never source.
*.log
