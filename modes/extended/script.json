  "patternSets": {
    "FEELING_ABOUT": [
      {
        "match": ["0", "{feeling:/FEELING}", "0"],
        "unnegated": ["feeling"],
        "templates": [
          "How long have you been {feeling}?",
          "What do you think brought on {feeling}?",
          "Tell me more about feeling {feeling}."
        ],
        "remember": "{feeling}",
        "context": { "topic": "feeling" }
      }
    ]
  },

  "families": [
    {
      "id": "FEELING_CAUSE",
      "topic": "feeling",
      "rank": 30,
      "examples": [
        "i feel anxious because my boss keeps piling on work",
        "i am sad because nobody listens to me",
        "i get angry because my brother never helps",
        "i am exhausted because i never get a break"
      ],
      "rules": [
        {
          "id": "FEELING_CAUSE.because",
          "rank": 34,
          "tags": ["FEELING"],
          "keywords": ["because"],
          "patterns": [
            {
              "match": ["0", "{feeling:/FEELING}", "because", "{reason}", "0"],
              "unnegated": ["feeling"],
              "templates": [
                "You say {reason}. What about that affects you most?",
                "So {reason}. That is what makes you feel {feeling}.",
                "You mention {reason}. Does it come up often?"
              ],
              "remember": "{reason}",
              "context": { "topic": "feeling", "expect": ["YES", "NO"] }
            },
            {
              "match": ["0", "because", "{reason}", "0"],
              "templates": [
                "You say {reason}. What about that affects you most?",
                "You trace it back to this: {reason}."
              ],
              "remember": "{reason}",
              "context": { "topic": "feeling" }
            }
          ]
        },
        {
          "id": "FEELING_CAUSE.bare",
          "rank": 22,
          "tags": ["FEELING"],
          "patternsFrom": "FEELING_ABOUT"
        }
      ]
    },

    {
      "id": "WORK_STRESS",
      "topic": "work",
      "rank": 28,
      "examples": [
        "my boss is on my case all day",
        "work is piling up and i cannot keep up",
        "i have too many deadlines this week",
        "my manager keeps changing the plan"
      ],
      "rules": [
        {
          "id": "WORK_STRESS.boss",
          "rank": 32,
          "keywords": ["boss"],
          "patterns": [
            {
              "match": ["0", "boss", "0"],
              "templates": [
                "Tell me more about your boss.",
                "What is your boss like?",
                "How long has your boss been a problem?"
              ],
              "context": { "topic": "work", "expect": ["YES", "NO"] }
            }
          ]
        },
        {
          "id": "WORK_STRESS.load",
          "rank": 26,
          "tags": ["WORK"],
          "patterns": [
            {
              "match": ["0", "on", "my", "case", "0"],
              "unnegated": ["case"],
              "templates": [
                "Who is on your case, and what do they want?",
                "What happens when they get on your case?"
              ],
              "context": { "topic": "work" }
            },
            {
              "match": ["0", "dumping", "more", "on", "my", "plate", "0"],
              "unnegated": ["dumping"],
              "templates": [
                "Who keeps putting more on your plate?",
                "How do you respond when more is added to your load?"
              ],
              "context": { "topic": "work" }
            },
            {
              "match": ["0", "{load}", "0"],
              "templates": [
                "You mention {load:flip}. What would it take to stay ahead of it?",
                "How long has it been like this?",
                "Does anyone at work see how much there is?"
              ],
              "remember": "{load}",
              "context": { "topic": "work" }
            }
          ]
        }
      ]
    },

